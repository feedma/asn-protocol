{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asn.dev/schemas/service-contract-v1.schema.json",
  "title": "ASN provider-defined service contract version 1",
  "type": "object",
  "required": [
    "contractVersion",
    "serviceId",
    "serviceVersion",
    "name",
    "description",
    "operations"
  ],
  "properties": {
    "contractVersion": { "const": "1" },
    "serviceId": {
      "type": "string",
      "pattern": "^[a-z0-9._/-]{1,128}$"
    },
    "serviceVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]{1,64}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9._/-]{1,64}$"
    },
    "identifiers": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "dataContract": {
      "type": "object",
      "required": ["schema", "mediaTypes"],
      "properties": {
        "schema": { "type": ["object", "boolean"] },
        "mediaTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/\\s]+/[^/\\s]+$",
            "maxLength": 127
          }
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "description",
        "executionModes",
        "input",
        "output"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9._/-]{1,128}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "executionModes": {
          "allOf": [
            { "$ref": "#/$defs/identifiers" },
            { "minItems": 1 }
          ]
        },
        "input": { "$ref": "#/$defs/dataContract" },
        "output": { "$ref": "#/$defs/dataContract" },
        "authorizationProtocols": { "$ref": "#/$defs/identifiers" },
        "paymentProtocols": { "$ref": "#/$defs/identifiers" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
